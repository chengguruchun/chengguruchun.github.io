  "defaultInputModes": ["text"],
  "defaultOutputModes": ["application/json", "text/markdown", "text/html"],
  "skills": [
    {
      "id": "discover",
      "name": "Discover",
      "description": "List Lab capabilities (discover-then-execute protocol).",
      "tags": ["discover", "agents"],
      "examples": ["GET /api/discover.json"],
      "inputModes": ["text"],
      "outputModes": ["application/json"]
    },
    {
      "id": "catalog",
      "name": "Catalog",
      "description": "Knowledge index: Articles, Diverse Lab, Times (Hot Words).",
      "tags": ["catalog", "knowledge"],
      "examples": ["GET /api/catalog.json"],
      "inputModes": ["text"],
      "outputModes": ["application/json"]
    },
    {
      "id": "skill-protocol",
      "name": "SKILL protocol",
      "description": "Blog for Agents protocol document.",
      "tags": ["skill"],
      "examples": ["GET /SKILL.md"],
      "inputModes": ["text"],
      "outputModes": ["text/markdown"]
    },
    {
      "id": "tools",
      "name": "Tool schemas",
      "description": "Static tool registry (MCP-shaped schemas for HTTP GET / local actions).",
      "tags": ["mcp", "tools"],
      "examples": ["GET /mcp/tools.json"],
      "inputModes": ["text"],
      "outputModes": ["application/json"]
    },
    {
      "id": "agent-native",
      "name": "Agent-native check",
      "description": "Weekly observe loop: whether the Lab still has discoverable, callable surfaces.",
      "tags": ["agents", "observe"],
      "examples": ["GET /api/agent-native/runs/latest.json"],
      "inputModes": ["text"],
      "outputModes": ["application/json"]
